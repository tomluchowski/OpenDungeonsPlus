            <Property name="HoverImage" value="OpenDungeonsIcons/AbortIcon" />
            <Property name="PushedImage" value="OpenDungeonsIcons/AbortIcon" />
            <Property name="TooltipText" value="Do not save modifications to the skill tree" />
