                        <Property name="ProgressImage" value="OpenDungeonsSkin/ProgressBarLitSegment" />
                        <Property name="ReversedProgress" value="True" />
                    </Window>
                </Window>
                <Window type="OD/ResearchButton" name="SummonChampionButton" >
                    <Property name="Area" value="{{0.2,-25},{0,195},{0.2,25},{0,245}}" />
