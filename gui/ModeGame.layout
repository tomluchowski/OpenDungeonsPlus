            <Property name="AlwaysOnTop" value="True" />
            <Property name="TooltipText" value="Query: select, then click a creature to view its information" />
        </Window>
        <Window type="OD/MiniMapCornerButton" name="MiniMapZoomButton">
            <Property name="CornerBackground" value="OpenDungeonsIcons/MiniMapCorner3" />
            <Property name="CornerIconArea" value="{{0.48,0},{0.48,0},{0.91,0},{0.91,0}}" />
