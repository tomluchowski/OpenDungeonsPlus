            <Property name="BackgroundEnabled" value="False" />
        </Window>
        <Window type="OD/MiniMapCornerButton" name="QueryButton" >
            <Property name="CornerBackground" value="OpenDungeonsIcons/MiniMapCorner0" />
            <Property name="CornerIconArea" value="{{0.09,0},{0.09,0},{0.52,0},{0.52,0}}" />
            <Property name="NavigationFrame" value="True" />
            <UserString name="AllowEdgeScrolling" value="true" />
            <Property name="Area" value="{{0,8},{1,-184},{0,52},{1,-140}}" />
