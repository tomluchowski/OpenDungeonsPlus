        </Window>
        <LayoutImport type="DefaultWindow" filename="WindowMap.layout" name="MapImport" />
        <LayoutImport type="DefaultWindow" filename="WindowUserCameras.layout" name="UserCamerasImport" />
    </Window>
</GUILayout>
