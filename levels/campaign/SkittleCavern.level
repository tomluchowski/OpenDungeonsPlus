Action	spawn	2	36	8	-1	Adventurer:1@Pin2
Action	spawn	2	38	8	-1	Adventurer:1@Pin3
Action	order	wait	2	-	Pin1	Pin2	Pin3
Action	addflag	lanesOpened	1
[/Trigger]
