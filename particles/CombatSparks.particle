particle_system CombatSparks
{
    material        CombatSparks
    particle_width  0.11
    particle_height 0.22
    cull_each       false
    quota           32
    billboard_type  oriented_self

    emitter Point
    {
        angle               180
        colour_range_start  1.0 0.95 0.55 1.0
        colour_range_end    1.0 0.45 0.08 1.0
        emission_rate       190
        time_to_live_min    0.18
        time_to_live_max    0.38
        direction           0 1 0.25
        velocity_min        1.4
        velocity_max        3.2
        duration            0.09
    }

    affector LinearForce
    {
        force_vector      0 0 -4.5
        force_application add
    }

    affector ColourFader
    {
        alpha -3.0
    }
}
