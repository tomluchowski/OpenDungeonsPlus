// Effects of the traps (see config/roomAmbienceTraps.cfg). Only textures and materials of the room
// ambience are used.

// ---------------------------------------------------------------- Alarm

// A fast flashing light when the alarm goes off
particle_system RoomAmbAlarmFlash
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  1.0
    particle_height 1.0
    cull_each       false
    quota           4
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 0.3 0.12 0.8
        emission_rate       4
        time_to_live        0.3
        direction           0 0 1
        velocity            0
        position            0 0 0.3
    }

    affector ColourFader
    {
        alpha   -2.6
    }
}

// Rings that spread outward over the floor
particle_system RoomAmbAlarmRing
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  0.3
    particle_height 0.3
    cull_each       false
    quota           4
    billboard_type  perpendicular_common
    common_direction 0 0 1
    common_up_vector 0 1 0

    emitter Point
    {
        angle               0
        colour              1.0 0.55 0.3 0.6
        emission_rate       1.6
        time_to_live        1.2
        direction           0 0 1
        velocity            0
        position            0 0 0.05
    }

    affector Scaler
    {
        rate    2.4
    }

    affector ColourFader
    {
        alpha   -0.5
    }
}

// ---------------------------------------------------------------- Fear

// Dark mist that settles on the floor
particle_system RoomAmbFearMist
{
    material        RoomAmbSmoke
    point_rendering false
    particle_width  0.9
    particle_height 0.9
    cull_each       false
    quota           4
    billboard_type  point

    emitter Box
    {
        angle               90
        colour              0.35 0.22 0.5 0.0
        emission_rate       0.7
        time_to_live        5
        direction           1 0 0
        velocity_min        0.03
        velocity_max        0.09
        position            0 0 0.12
        width               0.9
        height              0.9
        depth               0.05
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 0.35 0.22 0.5 0.0
        time1   0.5
        colour1 0.35 0.22 0.5 0.3
        time2   1
        colour2 0.35 0.22 0.5 0.0
    }

    affector Scaler
    {
        rate    0.08
    }
}

// A ghostly shape that bursts upward when the trap goes off
particle_system RoomAmbFearBurst
{
    material        RoomAmbSmoke
    point_rendering false
    particle_width  0.5
    particle_height 0.5
    cull_each       false
    quota           14
    billboard_type  point

    emitter Point
    {
        angle               25
        colour_range_start  0.75 0.82 1.0 0.5
        colour_range_end    0.9 0.95 1.0 0.55
        emission_rate       40
        time_to_live        1.3
        direction           0 0 1
        velocity_min        0.6
        velocity_max        1.4
        duration            0.3
        repeat_delay_min    1.2
        repeat_delay_max    3.0
        position            0 0 0.2
    }

    affector Scaler
    {
        rate    0.6
    }

    affector ColourFader
    {
        alpha   -0.55
    }
}

