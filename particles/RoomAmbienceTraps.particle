// ---------------------------------------------------------------- Linked traps

// A trap that a trigger trap sets off lights up in a short ring of glow
particle_system RoomAmbLinkedGlow
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  1.4
    particle_height 1.4
    cull_each       false
    quota           4
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              0.6 0.9 1.0 0.0
        emission_rate       4
        time_to_live        0.9
        direction           0 0 1
        velocity            0
        position            0 0 0.3
        duration            0.8
        repeat_delay_min    5
        repeat_delay_max    6
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 0.6 0.9 1.0 0.0
        time1   0.3
        colour1 0.6 0.9 1.0 0.75
        time2   1
        colour2 0.6 0.9 1.0 0.0
    }
}
