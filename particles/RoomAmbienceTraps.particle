}

// The flash of a bolt
particle_system RoomAmbBoltFlash
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  1.7
    particle_height 1.7
    cull_each       false
    quota           3
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              0.7 0.85 1.0 0.9
        emission_rate       30
        time_to_live        0.25
        direction           0 0 1
        velocity            0
        position            0 0 0.7
        duration            0.08
        repeat_delay_min    0.7
        repeat_delay_max    2.0
    }

    affector ColourFader
    {
        alpha   -3.6
    }
}

// Sparks that fly from the bolt
particle_system RoomAmbBoltSparks
{
    material        RoomAmbSpark
    point_rendering false
    particle_width  0.1
    particle_height 0.1
    cull_each       false
    quota           24
    billboard_type  point

    emitter Point
    {
        angle               180
        colour_range_start  0.6 0.8 1.0 1.0
        colour_range_end    1.0 1.0 1.0 1.0
        emission_rate       100
        time_to_live        0.7
        direction           0 0 1
        velocity_min        1.0
        velocity_max        2.6
        position            0 0 0.7
        duration            0.15
        repeat_delay_min    0.6
        repeat_delay_max    1.8
    }

    affector LinearForce
    {
        force_vector        0 0 -3
        force_application   add
    }

    affector ColourFader
    {
        alpha   -1.2
    }
}

// ---------------------------------------------------------------- Fire burst

// A jet of flame when the trap goes off
particle_system RoomAmbFlameJet
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  0.4
    particle_height 0.4
    cull_each       false
    quota           36
    billboard_type  point

    emitter Point
    {
        angle               10
        colour_range_start  1.0 0.6 0.15 0.9
        colour_range_end    1.0 0.85 0.35 0.9
        emission_rate       70
        time_to_live        0.7
        direction           0 0 1
        velocity_min        1.8
        velocity_max        3.0
        position            0 0 0.2
        duration            0.5
        repeat_delay_min    1.0
        repeat_delay_max    2.6
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 1.0 0.8 0.3 0.9
        time1   0.5
        colour1 1.0 0.35 0.1 0.6
        time2   1
        colour2 0.3 0.1 0.05 0.0
    }
}

