    billboard_type  point

    emitter Box
    {
        angle               80
        colour_range_start  0.45 0.8 0.25 0.45
        colour_range_end    0.6 0.9 0.35 0.5
        emission_rate       12
        time_to_live        3.0
        direction           0 0 1
        velocity_min        0.25
        velocity_max        0.7
        position            0 0 0.2
        width               0.6
        height              0.6
        depth               0.1
    }

    affector Scaler
    {
