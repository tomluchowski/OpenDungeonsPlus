        emission_rate       0.6
        time_to_live        4
        direction           0 0 1
        velocity_min        0.05
        velocity_max        0.12
        position            0 0 0.15
        width               0.6
        height              0.6
        depth               0.05
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 0.5 0.85 0.3 0.0
        time1   0.5
        colour1 0.5 0.85 0.3 0.2
        time2   1
        colour2 0.5 0.85 0.3 0.0
    }

    affector Scaler
    {
        rate    0.1
    }
}

// A cloud that billows and spreads when the trap goes off
particle_system RoomAmbGasCloud
{
    material        RoomAmbSmoke
    point_rendering false
    particle_width  0.6
    particle_height 0.6
    cull_each       false
