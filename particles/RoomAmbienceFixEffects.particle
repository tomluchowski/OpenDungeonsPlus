// Room ambience: the last effects of rooms, traps, doors and the keeper's hand (hit heart, wave portal, crypt,
// prison, torture chamber, cannon, rune door, hand cast). Format: see particles/RoomAmbience.particle.
// Only the materials of the other files are used, nothing new is drawn.

// ---- Dungeon heart: hit ----

// A fountain of hot sparks thrown out of the heart when it is hit
particle_system RoomAmbHeartHitBurst
{
    material        RoomAmbSpark
    point_rendering false
    particle_width  0.16
    particle_height 0.16
    cull_each       false
    quota           64
    billboard_type  point

    emitter Point
    {
        angle               75
        colour_range_start  1.0 0.3 0.2 1.0
        colour_range_end    1.0 0.85 0.5 1.0
        emission_rate       260
        time_to_live        0.9
        direction           0 0 1
        velocity_min        1.8
        velocity_max        4.2
        duration            0.15
    }

    affector LinearForce
    {
        force_vector        0 0 -5
        force_application   add
    }

    affector ColourFader
    {
        alpha   -1.1
    }
}

// ---- Wave portal ----

// Dust that rumbles up from the floor of the rift now and then
particle_system RoomAmbWaveRumble
{
    material        RoomAmbSmoke
    point_rendering false
    particle_width  0.36
    particle_height 0.36
    cull_each       false
    quota           24
    billboard_type  point

    emitter Box
    {
        angle               35
        colour_range_start  0.45 0.3 0.28 0.5
        colour_range_end    0.6 0.42 0.36 0.55
        emission_rate       18
        time_to_live        2.2
        direction           0 0 1
        velocity_min        0.25
        velocity_max        0.7
        position            0 0 0.1
        duration            0.9
        repeat_delay_min    2.5
        repeat_delay_max    5.0
        width               1.6
        height              1.6
        depth               0.05
    }

    affector Scaler
    {
        rate    0.45
    }

    affector ColourFader
    {
        alpha   -0.22
    }
}

// A surge of red-white light when a wave appears
particle_system RoomAmbWaveSurgeLight
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  3.4
    particle_height 3.4
    cull_each       false
    quota           3
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 0.55 0.4 0.9
        emission_rate       20
        time_to_live        1.1
        direction           0 0 1
        velocity            0
        position            0 0 0.7
        duration            0.1
    }

    affector Scaler
    {
        rate    2.2
    }

    affector ColourFader
    {
        alpha   -0.85
    }
}

// The shockwave on the floor, wider and faster than the portal's ring
particle_system RoomAmbWaveShockRing
{
    material        RoomAmbRingDust
    point_rendering false
    particle_width  0.6
    particle_height 0.6
    cull_each       false
    quota           4
    billboard_type  perpendicular_common
    common_direction 0 0 1
    common_up_vector 0 1 0

    emitter Point
    {
        angle               0
        colour              0.9 0.45 0.4 0.75
        emission_rate       8
        time_to_live        1.1
        direction           0 0 1
        velocity            0
        position            0 0 0.08
        duration            0.25
    }

    affector Scaler
    {
        rate                9
    }

    affector ColourFader
    {
        alpha               -0.7
    }
}

// ---- Crypt: raising ----

// The ground heaves: earth and dust pushed up
particle_system RoomAmbCryptEarth
{
    material        RoomAmbSmoke
    point_rendering false
    particle_width  0.4
    particle_height 0.4
    cull_each       false
    quota           40
    billboard_type  point

    emitter Box
    {
        angle               40
        colour_range_start  0.35 0.26 0.18 0.6
        colour_range_end    0.5 0.38 0.26 0.65
        emission_rate       40
        time_to_live        1.8
        direction           0 0 1
        velocity_min        0.3
        velocity_max        0.9
        position            0 0 0.05
        duration            0.9
        width               0.8
        height              0.8
        depth               0.05
    }

    affector Scaler
    {
        rate    0.5
    }

    affector LinearForce
    {
        force_vector        0 0 -0.4
        force_application   add
    }

    affector ColourFader
    {
        alpha   -0.35
    }
}

// Clods of earth thrown aside
particle_system RoomAmbCryptClods
{
    material        RoomAmbGrain
    point_rendering false
    particle_width  0.16
    particle_height 0.16
    cull_each       false
    quota           16
    billboard_type  point

    emitter Point
    {
        angle               60
        colour_range_start  0.45 0.34 0.24 1.0
        colour_range_end    0.6 0.46 0.32 1.0
        emission_rate       60
        time_to_live        0.9
        direction           0 0 1
        velocity_min        1.0
        velocity_max        2.2
        position            0 0 0.1
        duration            0.2
    }

    affector LinearForce
    {
        force_vector        0 0 -6
        force_application   add
    }

    affector ColourFader
