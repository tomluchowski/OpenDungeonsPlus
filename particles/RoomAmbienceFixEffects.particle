// ---- Rune door: damage ----

// Cracks that run across the runes
particle_system RoomAmbDoorRuneCracks
{
    material        RoomAmbMarkCracks
    point_rendering false
    particle_width  0.9
    particle_height 0.9
    cull_each       false
    quota           4
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              0.65 0.75 1.0 0.0
        emission_rate       8
        time_to_live        1.6
        direction           0 0 1
        velocity            0
        position            0 0 0.55
        duration            0.3
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 0.65 0.75 1.0 0.0
        time1   0.15
        colour1 0.65 0.75 1.0 0.85
        time2   0.5
        colour2 0.65 0.75 1.0 0.5
        time3   1
        colour3 0.65 0.75 1.0 0.0
    }
}

// Runes that flicker on and off, with sparks falling away
particle_system RoomAmbDoorRuneFlicker
{
    material        RoomAmbRune
    point_rendering false
    particle_width  0.7
    particle_height 0.7
    cull_each       false
    quota           6
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              0.6 0.75 1.0 0.0
        emission_rate       5
        time_to_live        1.5
        direction           0 0 1
        velocity            0
        position            0 0 0.55
        duration            0.35
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 0.6 0.75 1.0 0.0
        time1   0.12
        colour1 0.6 0.75 1.0 0.9
        time2   0.25
        colour2 0.6 0.75 1.0 0.1
        time3   0.4
        colour3 0.6 0.75 1.0 0.8
        time4   0.55
        colour4 0.6 0.75 1.0 0.0
        time5   0.7
        colour5 0.6 0.75 1.0 0.5
    }
}

// ---- Keeper's hand ----

// A small spark where the hand casts a spell
particle_system RoomAmbHandCastSpark
{
    material        RoomAmbSpark
    point_rendering false
    particle_width  0.1
    particle_height 0.1
    cull_each       false
    quota           16
    billboard_type  point

    emitter Point
    {
        angle               180
        colour_range_start  1.0 0.9 0.55 1.0
        colour_range_end    0.8 0.9 1.0 1.0
        emission_rate       90
        time_to_live        0.5
        direction           0 0 1
        velocity_min        0.4
        velocity_max        1.1
        duration            0.1
    }

    affector ColourFader
    {
        alpha   -1.8
    }
}
