// Pale green spirit light that rises out of the ground and fades
particle_system RoomAmbCryptSpirit
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  0.9
    particle_height 0.9
    cull_each       false
    quota           10
    billboard_type  point

    emitter Point
    {
        angle               8
        colour              0.55 1.0 0.7 0.0
        emission_rate       7
        time_to_live        2.2
        direction           0 0 1
        velocity_min        0.5
        velocity_max        0.9
        position            0 0 0.2
        duration            1.0
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 0.55 1.0 0.7 0.0
        time1   0.3
        colour1 0.55 1.0 0.7 0.7
        time2   1
        colour2 0.55 1.0 0.7 0.0
    }

    affector Scaler
    {
        rate    -0.25
    }
}

// ---- Torture chamber: conversion ----

// A cold white flash
particle_system RoomAmbTortureFlash
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  2.2
    particle_height 2.2
    cull_each       false
    quota           2
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              0.85 0.9 1.0 0.95
        emission_rate       20
        time_to_live        0.6
        direction           0 0 1
        velocity            0
        position            0 0 1.0
        duration            0.08
    }

    affector ColourFader
    {
        alpha   -1.4
    }
}

// Iron links of broken shackles that fall to the floor
particle_system RoomAmbTortureLinks
{
    material        RoomAmbCoin
    point_rendering false
    particle_width  0.14
    particle_height 0.14
    cull_each       false
    quota           14
    billboard_type  point

    emitter Box
    {
        angle               15
        colour_range_start  0.55 0.58 0.66 1.0
        colour_range_end    0.75 0.78 0.85 1.0
        emission_rate       28
        time_to_live        1.2
        direction           0 0 -1
        velocity_min        0.3
        velocity_max        1.0
        position            0 0 1.3
        duration            0.5
        width               0.5
        height              0.5
        depth               0.05
    }

    affector LinearForce
    {
        force_vector        0 0 -6
        force_application   add
    }

    affector Rotator
    {
        rotation_speed_range_start  -240
        rotation_speed_range_end    240
        rotation_range_start        0
        rotation_range_end          360
    }

    affector ColourFader
    {
        alpha   -0.8
    }
}

