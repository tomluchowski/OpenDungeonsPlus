// Extra room effects: unmade beds, altar fire and bell, rats, turning gears, the hurt heart and the converted flash
// (see config/roomAmbienceDeferred.cfg).
// Spark, glow and ember systems are shared with the other room ambience particle files.

// ---- Wall torches ----

// The iron bracket and the torch head, one billboard that stays
particle_system RoomAmbTorchBracket
{
    material        RoomAmbBracket
    point_rendering false
    particle_width  0.2
    particle_height 0.4
    cull_each       false
    quota           1
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 1.0 1.0 1.0
        emission_rate       2
        time_to_live        100000
        direction           0 0 1
        velocity            0
    }
}

// The flame on the torch head: one billboard that grows upward, the game makes it flicker
particle_system RoomAmbTorchFlame
{
    material        RoomAmbFlame
    point_rendering false
    particle_width  0.2
    particle_height 0.3
    cull_each       false
    quota           1
    billboard_type  point
    billboard_origin bottom_center

    emitter Point
    {
        angle               0
        colour              1.0 1.0 1.0 0.95
        emission_rate       2
        time_to_live        100000
        direction           0 0 1
        velocity            0
        position            0 0 0
    }
}

// A thin thread of smoke from the torch
particle_system RoomAmbTorchSmoke
{
    material        RoomAmbSmoke
    point_rendering false
    particle_width  0.12
    particle_height 0.12
    cull_each       false
    quota           8
    billboard_type  point

    emitter Point
    {
        angle               10
        colour_range_start  0.35 0.34 0.33 0.35
        colour_range_end    0.45 0.43 0.41 0.4
        emission_rate       1.6
        time_to_live        2.6
        direction           0 0 1
        velocity_min        0.25
        velocity_max        0.45
        position            0 0 0.4
    }

    affector Scaler
    {
        rate    0.12
    }

    affector ColourFader
    {
        alpha   -0.14
    }

    affector DirectionRandomiser
    {
        randomness  0.3
        scope       0.4
        keep_velocity true
    }
}

// ---- Unmade beds ----

// Folds of a blanket that nobody has smoothed out, lying flat on the bed
particle_system RoomAmbRumple
{
    material        RoomAmbRumple
    point_rendering false
    particle_width  0.85
    particle_height 0.85
    cull_each       false
    quota           1
    billboard_type  perpendicular_common
    common_direction 0 0 1
    common_up_vector 0 1 0

    emitter Point
    {
        angle               0
        colour              1.0 1.0 1.0 0.8
        emission_rate       2
        time_to_live        100000
        direction           0 0 1
        velocity            0
    }
}

// ---- Temple ----

// A big flame in the altar fire, grows upward, the game makes it flicker
particle_system RoomAmbAltarFlame
{
    material        RoomAmbFlame
    point_rendering false
    particle_width  0.45
    particle_height 0.75
    cull_each       false
    quota           1
    billboard_type  point
    billboard_origin bottom_center

    emitter Point
    {
        angle               0
        colour              1.0 0.95 0.9 0.95
        emission_rate       2
        time_to_live        100000
        direction           0 0 1
        velocity            0
    }
}

// ---- Prison ----

// A rat that runs along the wall now and then, head to the right
particle_system RoomAmbRatRight
{
    material        RoomAmbRat
    point_rendering false
    particle_width  0.36
    particle_height 0.36
    cull_each       false
    quota           1
    billboard_type  perpendicular_common
    common_direction 0 0 1
    common_up_vector 0 1 0

    emitter Point
    {
        angle               0
        colour              1.0 1.0 1.0 0.95
        emission_rate       10
        time_to_live        5.5
        direction           1 0 0
        velocity            0.38
        position            -1.0 0 0.04
        duration            0.1
        repeat_delay_min    9
        repeat_delay_max    34
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 1 1 1 0
        time1   0.12
        colour1 1 1 1 0.95
        time2   0.88
        colour2 1 1 1 0.95
        time3   1
        colour3 1 1 1 0
    }
}

// A rat that runs along the wall now and then, head to the left
particle_system RoomAmbRatLeft
{
    material        RoomAmbRatL
    point_rendering false
    particle_width  0.36
    particle_height 0.36
    cull_each       false
    quota           1
    billboard_type  perpendicular_common
    common_direction 0 0 1
    common_up_vector 0 1 0

    emitter Point
    {
        angle               0
        colour              1.0 1.0 1.0 0.95
        emission_rate       10
        time_to_live        5.5
        direction           -1 0 0
        velocity            0.38
        position            1.0 0 0.04
        duration            0.1
        repeat_delay_min    11
        repeat_delay_max    40
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 1 1 1 0
        time1   0.12
        colour1 1 1 1 0.95
        time2   0.88
        colour2 1 1 1 0.95
        time3   1
        colour3 1 1 1 0
    }
}

// ---- Workshop ----

// A big cog that turns while the machine is worked
particle_system RoomAmbGearBig
{
    material        RoomAmbGear
    point_rendering false
    particle_width  0.5
    particle_height 0.5
    cull_each       false
    quota           1
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 1.0 1.0 0.95
        emission_rate       2
        time_to_live        100000
        direction           0 0 1
        velocity            0
    }

    affector Rotator
    {
        rotation_speed_range_start  75
        rotation_speed_range_end    75
        rotation_range_start        0
        rotation_range_end          0
    }
}

// A small cog that turns the other way, faster
particle_system RoomAmbGearSmall
{
    material        RoomAmbGear
    point_rendering false
    particle_width  0.3
    particle_height 0.3
    cull_each       false
    quota           1
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 1.0 1.0 0.95
        emission_rate       2
        time_to_live        100000
        direction           0 0 1
        velocity            0
    }

    affector Rotator
    {
        rotation_speed_range_start  -125
        rotation_speed_range_end    -125
        rotation_range_start        22
        rotation_range_end          22
    }
}


// Rings of light that spread over the floor when the bell rings
particle_system RoomAmbGongRing
{
    material        RoomAmbSoftRing
    point_rendering false
    particle_width  0.4
    particle_height 0.4
    cull_each       false
    quota           4
    billboard_type  perpendicular_common
    common_direction 0 0 1
    common_up_vector 0 1 0

    emitter Point
    {
        angle               0
        colour              1.0 0.85 0.45 0.8
        emission_rate       14
        time_to_live        1.8
        direction           0 0 1
        velocity            0
        position            0 0 0.06
        duration            0.2
    }

    affector Scaler
    {
        rate    2.4
    }

    affector ColourFader
    {
        alpha   -0.45
    }
}

// Golden specks that rise from the one who was healed
particle_system RoomAmbBellSparks
{
    material        RoomAmbSpark
    point_rendering false
    particle_width  0.1
    particle_height 0.1
    cull_each       false
    quota           24
    billboard_type  point

    emitter Box
    {
        angle               25
        colour_range_start  1.0 0.85 0.4 1.0
        colour_range_end    1.0 0.95 0.65 1.0
        emission_rate       40
        time_to_live        1.6
        direction           0 0 1
        velocity_min        0.3
        velocity_max        1.0
        position            0 0 0.3
        duration            0.5
        width               0.5
        height              0.5
        depth               0.1
    }

    affector ColourFader
    {
        alpha   -0.6
    }
}

// ---- Dungeon heart ----

// A red pulse of light from a hurt heart
particle_system RoomAmbHeartPulse
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  1.9
    particle_height 1.9
    cull_each       false
    quota           2
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 0.15 0.1 0.65
        emission_rate       20
        time_to_live        0.7
        direction           0 0 1
        velocity            0
        position            0 0 1.3
        duration            0.08
    }

    affector ColourFader
    {
        alpha   -0.95
    }
}

// Embers that drop from a hurt heart
particle_system RoomAmbHeartDrops
{
    material        RoomAmbSpark
    point_rendering false
    particle_width  0.09
    particle_height 0.09
    cull_each       false
    quota           14
    billboard_type  point

    emitter Point
    {
        angle               60
        colour_range_start  1.0 0.2 0.15 1.0
        colour_range_end    1.0 0.5 0.25 1.0
        emission_rate       40
        time_to_live        1.2
        direction           0 0 1
        velocity_min        0.3
        velocity_max        0.9
        position            0 0 1.3
        duration            0.2
    }

    affector LinearForce
    {
        force_vector        0 0 -2.2
        force_application   add
    }

    affector ColourFader
    {
        alpha   -0.8
    }
}

// ---- Conversion ----

// A violet ring of light where a prisoner changed sides
particle_system RoomAmbConvertRing
{
    material        RoomAmbSoftRing
    point_rendering false
    particle_width  0.4
    particle_height 0.4
    cull_each       false
    quota           3
    billboard_type  perpendicular_common
    common_direction 0 0 1
    common_up_vector 0 1 0

    emitter Point
    {
        angle               0
        colour              0.75 0.45 1.0 0.9
        emission_rate       16
        time_to_live        1.1
        direction           0 0 1
        velocity            0
        position            0 0 0.06
        duration            0.15
    }

    affector Scaler
    {
        rate    3.2
    }

    affector ColourFader
    {
        alpha   -0.9
    }
}

// The flash itself, violet
particle_system RoomAmbConvertFlash
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  1.9
    particle_height 1.9
    cull_each       false
    quota           2
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              0.85 0.6 1.0 0.9
        emission_rate       20
        time_to_live        0.55
        direction           0 0 1
        velocity            0
        position            0 0 0.7
        duration            0.08
    }

    affector ColourFader
    {
        alpha   -1.5
    }
}
