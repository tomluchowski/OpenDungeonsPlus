// Short effects of the worker reactions (see config/creatureReactions.cfg, events Dig*, Pick*, Claim*, Gold*).
// They reuse the materials of the creature reactions and are put on the worker for the time the reaction takes.

particle_system WorkerDirt
{
    material        ReactionParticleDust
    point_rendering false
    particle_width  0.16
    particle_height 0.16
    cull_each       false
    quota           30
    billboard_type  point

    emitter Point
    {
        angle               70
        colour_range_start  0.50 0.36 0.22 1.0
        colour_range_end    0.65 0.48 0.30 1.0
        emission_rate       45
        time_to_live        0.7
        direction           0 0 1
        velocity_min        0.8
        velocity_max        1.6
        duration            0.35
        position            0 0 0.3
    }

    affector LinearForce
    {
        force_vector      0 0 -5.0
        force_application add
    }

    affector ColourFader
    {
        alpha -1.2
    }
}

particle_system WorkerRockSparks
{
    material        ReactionParticleSpark
    point_rendering false
    particle_width  0.1
    particle_height 0.1
    cull_each       false
    quota           30
    billboard_type  point

    emitter Point
    {
        angle               110
        colour_range_start  1.0 0.85 0.45 1.0
        colour_range_end    1.0 1.0 0.85 1.0
        emission_rate       70
        time_to_live        0.4
        direction           0 0 1
        velocity_min        1.2
        velocity_max        2.6
        duration            0.25
        position            0 0 0.3
    }

    affector LinearForce
    {
        force_vector      0 0 -4.0
        force_application add
    }

    affector ColourFader
    {
        alpha -2.2
    }
}

particle_system WorkerGoldSplinters
{
    material        ReactionParticleCoin
    point_rendering false
    particle_width  0.08
    particle_height 0.08
    cull_each       false
    quota           30
    billboard_type  point

    emitter Point
    {
        angle               80
        colour_range_start  1.0 0.85 0.3 1.0
        colour_range_end    1.0 0.95 0.55 1.0
        emission_rate       50
        time_to_live        0.8
        direction           0 0 1
        velocity_min        0.9
        velocity_max        2.0
        duration            0.4
        position            0 0 0.3
    }

    affector LinearForce
    {
        force_vector      0 0 -5.0
        force_application add
    }

    affector Rotator
    {
        rotation_speed_range_start  -300
        rotation_speed_range_end    300
        rotation_range_start        0
        rotation_range_end          360
    }

    affector ColourFader
    {
        alpha -0.9
    }
}

