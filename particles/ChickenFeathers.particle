    particle_width 0.11
    particle_height 0.11
    quota 20
    billboard_type point
    emitter Point
    {
        angle 80
        colour_range_start 1.0 0.98 0.94 1.0
        colour_range_end 0.93 0.9 0.84 1.0
        emission_rate 36
        time_to_live_min 1.6
        time_to_live_max 2.3
        direction 0 0 1
        velocity_min 0.6
        velocity_max 1.5
        duration 0.15
