// Room ambience: the dungeon heart in danger, the casino (win and loss) and the cheering crowd of the arena.
// Format: see particles/RoomAmbience.particle. Only the materials of the other files are used.

// ---- Dungeon heart: low health ----

// A wide red flare that swells and fades, again and again
particle_system RoomAmbHeartLowFlare
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  1.8
    particle_height 1.8
    cull_each       false
    quota           4
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 0.2 0.15 0.55
        emission_rate       12
        time_to_live        0.9
        direction           0 0 1
        velocity            0
        position            0 0 0
        duration            0.15
        repeat_delay_min    0.5
        repeat_delay_max    0.8
    }

    affector Scaler
    {
        rate    1.2
    }

    affector ColourFader
    {
        alpha   -0.6
    }
}

// Sparks thrown out of the heart in bursts
particle_system RoomAmbHeartLowBurst
{
    material        RoomAmbSpark
    point_rendering false
    particle_width  0.14
    particle_height 0.14
    cull_each       false
    quota           50
    billboard_type  point

    emitter Point
    {
        angle               90
        colour_range_start  1.0 0.25 0.2 1.0
        colour_range_end    1.0 0.75 0.45 1.0
        emission_rate       130
        time_to_live        1.0
        direction           0 0 1
        velocity_min        1.5
        velocity_max        3.5
        position            0 0 0
        duration            0.2
        repeat_delay_min    0.6
        repeat_delay_max    1.2
    }

    affector LinearForce
    {
        force_vector        0 0 -4
        force_application   add
    }

    affector ColourFader
    {
        alpha   -1.0
    }
}

// The last moments: a large, fast, white-hot flare
particle_system RoomAmbHeartLowCritical
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  2.6
    particle_height 2.6
    cull_each       false
    quota           6
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 0.55 0.4 0.7
        emission_rate       14
        time_to_live        0.6
        direction           0 0 1
        velocity            0
        position            0 0 0
        duration            0.12
        repeat_delay_min    0.3
        repeat_delay_max    0.5
    }

    affector Scaler
    {
        rate    1.8
    }

    affector ColourFader
    {
        alpha   -1.1
    }
}

// ---- Casino ----

// A fountain of coins that falls back onto the table
particle_system RoomAmbCasinoWinCoins
{
    material        RoomAmbCoin
    point_rendering false
    particle_width  0.1
    particle_height 0.1
    cull_each       false
    quota           40
    billboard_type  point

    emitter Point
    {
        angle               25
        colour              1.0 1.0 1.0 1.0
        emission_rate       90
        time_to_live        1.3
        direction           0 0 1
        velocity_min        2.0
        velocity_max        3.6
        position            0 0 0
        duration            0.45
    }

    affector LinearForce
    {
        force_vector        0 0 -8
        force_application   add
    }

    affector Rotator
    {
        rotation_speed_range_start  -400
        rotation_speed_range_end    400
        rotation_range_start        0
        rotation_range_end          360
    }
}

// Gold sparkles drifting down after the win
particle_system RoomAmbCasinoWinRain
{
    material        RoomAmbSpark
    point_rendering false
    particle_width  0.09
    particle_height 0.09
    cull_each       false
    quota           30
    billboard_type  point

    emitter Box
    {
        angle               10
        colour_range_start  1.0 0.8 0.3 1.0
        colour_range_end    1.0 0.95 0.6 1.0
        emission_rate       40
        time_to_live        1.3
        direction           0 0 -1
        velocity_min        0.3
        velocity_max        0.9
        position            0 0 1.4
        duration            0.7
        width               0.9
        height              0.9
        depth               0.1
    }

    affector ColourFader
    {
        alpha   -0.8
    }
}

// Grey smoke curling up from the table of the loser
particle_system RoomAmbCasinoLossSmoke
{
    material        RoomAmbSmoke
    point_rendering false
    particle_width  0.35
    particle_height 0.35
    cull_each       false
    quota           14
    billboard_type  point

    emitter Point
    {
        angle               25
        colour_range_start  0.45 0.45 0.48 0.5
        colour_range_end    0.6 0.6 0.62 0.6
        emission_rate       16
        time_to_live        1.8
        direction           0 0 1
        velocity_min        0.35
        velocity_max        0.8
        position            0 0 0.6
        duration            0.6
    }

    affector Scaler
    {
        rate    0.35
    }

    affector ColourFader
    {
        alpha   -0.35
    }
}

// A few dull sparks that die as they fall
particle_system RoomAmbCasinoLossSparks
{
    material        RoomAmbSpark
    point_rendering false
    particle_width  0.1
    particle_height 0.1
    cull_each       false
    quota           14
    billboard_type  point

    emitter Point
    {
        angle               60
        colour_range_start  0.55 0.55 0.6 1.0
        colour_range_end    0.8 0.7 0.6 1.0
        emission_rate       30
        time_to_live        0.9
        direction           0 0 1
        velocity_min        0.8
        velocity_max        1.7
        position            0 0 0.6
        duration            0.3
    }

    affector LinearForce
    {
        force_vector        0 0 -4.5
        force_application   add
    }

    affector ColourFader
    {
        red     -0.3
        green   -0.3
        blue    -0.3
        alpha   -1.0
    }
}

// ---- Arena ----

// Confetti thrown into the air over the sand when the crowd cheers
particle_system RoomAmbArenaCheerConfetti
{
    material        RoomAmbSpark
    point_rendering false
    particle_width  0.1
    particle_height 0.1
    cull_each       false
    quota           40
    billboard_type  point

    emitter Box
    {
        angle               30
        colour_range_start  1.0 0.55 0.2 1.0
        colour_range_end    0.4 0.8 1.0 1.0
        emission_rate       60
        time_to_live        1.6
        direction           0 0 1
        velocity_min        1.0
        velocity_max        2.6
        position            0 0 0.8
        duration            0.7
        width               2.4
        height              2.4
        depth               0.1
    }

    affector LinearForce
    {
        force_vector        0 0 -3.5
        force_application   add
    }

    affector Rotator
    {
        rotation_speed_range_start  -300
        rotation_speed_range_end    300
        rotation_range_start        0
        rotation_range_end          360
    }

    affector ColourFader
    {
        alpha   -0.55
    }
}
