    {
        alpha               -0.909091
    }
}

// A few motes around the new worker for a short time
particle_system SpellCreatureArrival
{
    material        RoomAmbSpark
    point_rendering false
    particle_width  0.09
    particle_height 0.09
    cull_each       false
    quota           20
    billboard_type  point

    emitter Box
    {
        angle               40
        colour_range_start  0.6 0.7 1 0
        colour_range_end    0.8 0.9 1 0
        emission_rate       14
        time_to_live        1
        direction           0 0 1
        velocity_min        0.1
        velocity_max        0.4
        position            0 0 0.3
        width               0.4
        height              0.4
        depth               0.6
    }

    affector LinearForce
    {
        force_vector        0 0 0.6
        force_application   add
    }

    affector ColourInterpolator
    {
        time0               0
        colour0             0.6 0.7 1 0
        time1               0.3
        colour1             0.6 0.7 1 0.8
        time2               1
        colour2             0.6 0.7 1 0
    }
}

