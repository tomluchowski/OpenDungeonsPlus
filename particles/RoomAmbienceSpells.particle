    {
        angle               50
        colour_range_start  0.5 0.6 1 1
        colour_range_end    0.8 0.85 1 1
        emission_rate       45
        time_to_live        1.1
        direction           0 0 1
        velocity_min        0.4
        velocity_max        1.4
        position            0 0 0.1
        duration            0.4
        width               0.5
        height              0.5
        depth               0.1
    }

    affector LinearForce
    {
