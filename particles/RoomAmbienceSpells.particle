// Cosmetic effects of the spells (client side): the cast marker, the area or travel, the impact and the lasting
// look. Events (SpellFx...) are started by config/roomAmbienceSpells.cfg and config/roomAmbienceSpellsFx.cfg when the
// server reports a cast. Only existing sprites of the room ambience are used.

// ---------------------------------------------------------------- Defector
// A swirl on the floor that turns from blue to red
particle_system SpFxTurnSwirl
{
    material        RoomAmbSwirl
    point_rendering false
    particle_width  1.4
    particle_height 1.4
    cull_each       false
    quota           3
    billboard_type  perpendicular_common
    common_direction 0 0 1
    common_up_vector 0 1 0

    emitter Point
    {
        angle               0
        colour              0.5 0.4 1.0 0.9
        emission_rate       6
        time_to_live        1.0
        direction           0 0 1
        velocity            0
        position            0 0 0.1
        duration            0.3
    }

    affector Scaler
    {
        rate                0.8
    }

    affector ColourInterpolator
    {
        time0               0
        colour0             0.4 0.4 1.0 0.0
        time1               0.3
        colour1             0.7 0.4 0.9 0.8
        time2               1
        colour2             1.0 0.3 0.3 0.0
    }

    affector Rotator
    {
        rotation_speed_range_start 300
        rotation_speed_range_end 400
        rotation_range_start 0
        rotation_range_end  360
    }
}

// ---------------------------------------------------------------- Hexen hen
// A puff of smoke at the change, in both directions
particle_system SpFxHenPuff
{
    material        RoomAmbSmoke
    point_rendering false
    particle_width  0.7
    particle_height 0.7
    cull_each       false
    quota           46
    billboard_type  point

    emitter Box
    {
        angle               120
        colour              0.85 0.85 0.9 0
        emission_rate       40
        time_to_live        1
        direction           0 0 1
        velocity_min        0.3
        velocity_max        0.9
        position            0 0 0.5
        duration            0.2
        width               0.4
        height              0.4
        depth               0.05
    }

    affector Scaler
    {
        rate                0.8
    }

    affector ColourInterpolator
    {
        time0               0
        colour0             0.85 0.85 0.9 0
        time1               0.2
        colour1             0.85 0.85 0.9 0.7
        time2               1
        colour2             0.85 0.85 0.9 0
    }
}

// A short flash
particle_system SpFxHenFlash
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  1.1
    particle_height 1.1
    cull_each       false
    quota           3
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1 0.9 0.6 0.9
        emission_rate       10
        time_to_live        0.4
        direction           0 0 1
        velocity            0
        position            0 0 0.5
        duration            0.1
    }

    affector ColourFader
    {
        alpha               -2.25
    }
}

// ---------------------------------------------------------------- Inferno
// A flame burst on a creature that catches fire
particle_system SpFxFireHit
{
    material        RoomAmbSpark
    point_rendering false
    particle_width  0.22
    particle_height 0.22
    cull_each       false
    quota           44
    billboard_type  point

    emitter Box
    {
        angle               30
        colour_range_start  1 0.35 0.05 0.9
        colour_range_end    1 0.8 0.2 0.9
        emission_rate       72
        time_to_live        0.9
        direction           0 0 1
        velocity_min        0.8
        velocity_max        2
        position            0 0 0.2
        duration            0.5
        width               0.5
        height              0.5
        depth               0.2
    }

    affector LinearForce
    {
        force_vector        0 0 1
        force_application   add
    }

    affector ColourFader
    {
        alpha               -1
    }
}

