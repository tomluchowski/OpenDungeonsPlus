// ---------------------------------------------------------------- Ground marks
// Flat marks that stay on the floor for a while (kind Mark in config/roomAmbienceSpells.cfg, at most MaxMarks at once)
particle_system SpFxMarkScorch
{
    material        RoomAmbMarkScorch
    point_rendering false
    particle_width  1.3
    particle_height 1.3
    cull_each       false
    quota           1
    billboard_type  perpendicular_common
    common_direction 0 0 1
    common_up_vector 0 1 0

    emitter Point
    {
        angle               0
        colour              1 1 1 0.9
        emission_rate       30
        time_to_live        22
        direction           0 0 1
        velocity            0
        position            0 0 0.05
        duration            0.15
    }

    // Stays at full strength, then fades out over the last third of its life
    affector ColourInterpolator
    {
        time0   0
        colour0 1 1 1 0.9
        time1   0.65
        colour1 1 1 1 0.9
        time2   1
        colour2 1 1 1 0
    }

    affector Rotator
    {
        rotation_range_start 0
        rotation_range_end 360
        rotation_speed_range_start 0
        rotation_speed_range_end 0
    }
}

