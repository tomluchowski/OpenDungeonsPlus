    {
        angle               0
        colour              0.7 0.75 1 0.9
        emission_rate       10
        time_to_live        0.5
        direction           0 0 1
        velocity            0
        position            0 0 0.6
        duration            0.1
    }

    affector ColourFader
    {
        alpha               -1.8
    }
}

// Motes that rise from the arrival spot
particle_system SpFxSummonMotes
{
