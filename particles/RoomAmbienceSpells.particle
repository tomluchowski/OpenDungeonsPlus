// Cosmetic effects of the spells (client side): the cast marker, the area or travel, the impact and
// the lasting look. Events (SpellFx...) are started by config/roomAmbienceSpells.cfg when the server
// reports a cast; the SpellCreature... systems are auras on creatures, started like the other
// creature effects. Only existing sprites of the room ambience are used.

// ---------------------------------------------------------------- Summon worker
// A ring of light that spreads over the floor at the arrival spot
particle_system SpFxSummonRing
{
    material        RoomAmbRingRunes
    point_rendering false
    particle_width  0.3
    particle_height 0.3
    cull_each       false
    quota           4
    billboard_type  perpendicular_common
    common_direction 0 0 1
    common_up_vector 0 1 0

    emitter Point
    {
        angle               0
        colour              0.55 0.6 1 0.7
        emission_rate       6
        time_to_live        0.9
        direction           0 0 1
        velocity            0
        position            0 0 0.08
        duration            0.3
    }

    affector Scaler
    {
        rate                3.2
    }

    affector ColourFader
    {
        alpha               -0.777778
    }
}

// A flash when the worker arrives
