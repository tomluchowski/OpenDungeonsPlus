// Room ambience: the short effects of three moments in the rooms (a creature wakes up in the
// dormitory, an enemy enters the guard room, a creature is healed in the temple).
// Format: see particles/RoomAmbience.particle. Only the materials of the other files are used.

// ---- Dormitory: a creature gets up ----

// The blanket is thrown back: a puff of fluff and dust to the sides
particle_system RoomAmbWakeBlanket
{
    material        RoomAmbDust
    point_rendering false
    particle_width  0.3
    particle_height 0.3
    cull_each       false
    quota           12
    billboard_type  point

    emitter Point
    {
        angle               80
        colour_range_start  0.9 0.85 0.75 0.7
        colour_range_end    1.0 0.95 0.85 0.8
        emission_rate       50
        time_to_live        1.2
        direction           0 0 1
        velocity_min        0.5
        velocity_max        1.3
        position            0 0 0.4
        duration            0.2
    }

    affector LinearForce
    {
        force_vector        0 0 -1.2
        force_application   add
    }

    affector Scaler
    {
        rate    0.4
    }

    affector ColourFader
    {
        alpha   -0.7
    }
}

// The first light of the day on the bed
particle_system RoomAmbWakeLight
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  1.4
    particle_height 1.4
    cull_each       false
    quota           3
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 0.92 0.65 0.5
        emission_rate       10
        time_to_live        1.6
        direction           0 0 1
        velocity            0
        position            0 0 0.5
        duration            0.15
    }

    affector ColourFader
    {
        alpha   -0.32
    }
}

// ---- Guard room: the alarm ----

// The horn glows red above the intruder
particle_system RoomAmbAlarmHorn
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  1.1
    particle_height 1.1
    cull_each       false
    quota           6
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 0.3 0.15 0.7
        emission_rate       3
        time_to_live        0.9
        direction           0 0 1
        velocity            0
        position            0 0 1.2
        duration            2.4
    }

    affector Scaler
    {
        rate    0.5
    }

    affector ColourFader
    {
        alpha   -0.75
    }
}

// A wave of sound spreading over the floor
particle_system RoomAmbAlarmWave
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  0.6
    particle_height 0.6
    cull_each       false
    quota           4
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 0.55 0.3 0.45
        emission_rate       2
        time_to_live        1.1
        direction           0 0 1
        velocity            0
        position            0 0 0.2
        duration            2.0
    }

    affector Scaler
    {
        rate    3.2
    }

    affector ColourFader
    {
        alpha   -0.4
    }
}

// The guards stamp to attention: dust from the floor in every direction
particle_system RoomAmbAlarmStomp
{
    material        RoomAmbSmoke
    point_rendering false
    particle_width  0.3
    particle_height 0.3
    cull_each       false
    quota           14
    billboard_type  point

    emitter Point
    {
        angle               90
        colour_range_start  0.72 0.64 0.5 0.45
        colour_range_end    0.82 0.74 0.6 0.5
        emission_rate       40
        time_to_live        1.0
        direction           0 0 1
        velocity_min        0.3
        velocity_max        0.9
        position            0 0 0.1
        duration            0.25
    }

    affector Scaler
    {
        rate    0.5
    }

    affector ColourFader
    {
        alpha   -0.5
    }
}

// ---- Temple: the bell and the healing light ----

// Rings of golden light, one after the other, as the bell swings
particle_system RoomAmbBellRing
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  0.5
    particle_height 0.5
    cull_each       false
    quota           4
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 0.85 0.45 0.4
        emission_rate       1.6
        time_to_live        1.4
        direction           0 0 1
        velocity            0
        position            0 0 0.9
        duration            2.5
    }

    affector Scaler
    {
        rate    2.2
    }

    affector ColourFader
    {
        alpha   -0.3
    }
}

// Soft light on a creature that was healed
particle_system RoomAmbHealLight
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  1.2
    particle_height 1.2
    cull_each       false
    quota           3
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              0.7 1.0 0.8 0.45
        emission_rate       8
        time_to_live        1.8
        direction           0 0 1
        velocity            0
        position            0 0 0.5
        duration            0.2
    }

    affector ColourFader
    {
        alpha   -0.25
    }
}

// Specks rising from it
particle_system RoomAmbHealSpecks
{
    material        RoomAmbSpark
    point_rendering false
    particle_width  0.1
    particle_height 0.1
    cull_each       false
    quota           14
    billboard_type  point

    emitter Ring
    {
        angle               10
        colour_range_start  0.7 1.0 0.8 1.0
        colour_range_end    1.0 1.0 0.8 1.0
        emission_rate       14
        time_to_live        1.6
        direction           0 0 1
        velocity_min        0.3
        velocity_max        0.7
        position            0 0 0.2
        duration            0.8
        width               0.6
        height              0.6
        depth               0.1
    }

    affector ColourFader
    {
        alpha   -0.6
    }
}
