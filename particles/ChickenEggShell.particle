// Pieces of eggshell that fly when an egg hatches
particle_system ChickenEggShell
{
    material ChickenEggShell
    particle_width 0.022
    particle_height 0.022
    quota 20
    billboard_type point
    emitter Point
    {
        angle 70
        colour_range_start 0.98 0.93 0.8 1.0
        colour_range_end 0.85 0.78 0.62 1.0
        emission_rate 120
        time_to_live_min 0.5
        time_to_live_max 0.9
        direction 0 0 1
        velocity_min 0.4
        velocity_max 0.9
        duration 0.1
    }
    affector LinearForce
    {
        force_vector 0 0 -2.2
        force_application add
    }
    affector Rotator
    {
        rotation_range_start 0
        rotation_range_end 360
        rotation_speed_range_start -200
        rotation_speed_range_end 200
    }
    affector ColourFader
    {
        alpha -0.9
    }
}

// Shell pieces and yolk drops that fly when an egg is trampled: the shell emitter is the one of the hatching
// shell, the yolk emitter throws yellow drops that stay lower and wider
particle_system ChickenEggTrample
{
    material ChickenEggShell
    particle_width 0.026
    particle_height 0.026
    quota 40
    billboard_type point
    emitter Point
    {
        angle 80
        colour_range_start 0.98 0.93 0.8 1.0
        colour_range_end 0.85 0.78 0.62 1.0
        emission_rate 160
        time_to_live_min 0.5
        time_to_live_max 0.9
        direction 0 0 1
        velocity_min 0.5
        velocity_max 1.1
        duration 0.1
    }
    emitter Point
    {
        angle 90
        colour_range_start 1.0 0.78 0.12 1.0
        colour_range_end 0.95 0.6 0.05 1.0
        emission_rate 200
        time_to_live_min 0.4
        time_to_live_max 0.8
        direction 0 0 1
        velocity_min 0.3
        velocity_max 0.8
        duration 0.1
    }
    affector LinearForce
    {
        force_vector 0 0 -2.6
        force_application add
    }
    affector Rotator
    {
        rotation_range_start 0
        rotation_range_end 360
        rotation_speed_range_start -200
        rotation_speed_range_end 200
    }
    affector ColourFader
    {
        alpha -0.9
    }
}
