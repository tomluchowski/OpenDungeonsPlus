// Burst of the dungeon heart in the defeat sequence. The sequence creates the four systems at the moment
// the heart bursts, with their node in the middle of the heart (1 above the floor), and removes them at the
// end of the explosion phase (15 s). Every emitter has a duration, so the burst is strongest in the first
// seconds and dies out; particles live in world space, so the deflector plane is the floor (z = 0).
// Particles that are added to the scene fade by colour (ColourInterpolator to black), as their alpha has no
// effect with additive blending.

// Fireballs: a big burst that is thrown out and up, falls under gravity and glows on the floor, then fewer
// and fewer embers for about 11 s
particle_system HeartExplosion
{
    material        DefeatFireball
    point_rendering false
    particle_width  0.42
    particle_height 0.42
    cull_each       false
    quota           400
    billboard_type  point

    emitter Ellipsoid
    {
        angle               65
        colour              1.0 0.6 0.15 1.0
        emission_rate       110
        time_to_live_min    2.5
        time_to_live_max    4.0
        direction           0 0 1
        velocity_min        1.6
        velocity_max        3.6
        width               0.8
        height              0.8
        depth               0.6
        duration            0.4
    }

    emitter Point
    {
        angle               50
        colour              1.0 0.6 0.15 1.0
        emission_rate       9
        time_to_live_min    2.0
        time_to_live_max    3.5
        direction           0 0 1
        velocity_min        1.2
        velocity_max        2.8
        duration            3
    }

    emitter Point
    {
        angle               40
        colour              1.0 0.6 0.15 1.0
        emission_rate       2.5
        time_to_live_min    1.8
        time_to_live_max    3.0
        direction           0 0 1
        velocity_min        0.8
        velocity_max        2.0
        duration            11
    }

    affector LinearForce
    {
        force_vector      0 0 -4
        force_application add
    }

    affector DeflectorPlane
    {
        plane_point  0 0 0.08
        plane_normal 0 0 1
        bounce       0.25
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 1 0.9 0.55 1
        time1   0.2
        colour1 1 0.55 0.12 1
        time2   0.7
        colour2 0.6 0.18 0.03 1
        time3   1
        colour3 0 0 0 1
    }

    affector Scaler
    {
        rate -0.07
    }
}

// Flash at the moment of the burst: a few big glows that fade within half a second
particle_system HeartExplosionFlash
{
    material        DefeatFireball
    point_rendering false
    particle_width  3.2
    particle_height 3.2
    cull_each       false
    quota           10
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 0.9 0.6 1.0
        emission_rate       40
        time_to_live_min    0.45
        time_to_live_max    0.6
        direction           0 0 1
        velocity            0
        duration            0.1
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 1 0.95 0.75 1
        time1   0.4
        colour1 1 0.5 0.15 1
        time2   1
        colour2 0 0 0 1
    }
}

// Turquoise-green sparks: a fast burst, then sparks that rise from the ruin for about 12 s
particle_system HeartExplosionSparks
{
    material        CombatSparks
    point_rendering false
    particle_width  0.22
    particle_height 0.22
    cull_each       false
    quota           300
    billboard_type  point

    emitter Point
    {
        angle               80
        colour              0.6 1.0 0.9 1.0
        emission_rate       160
        time_to_live_min    1.5
        time_to_live_max    3.0
        direction           0 0 1
        velocity_min        2.0
        velocity_max        4.5
        duration            0.3
    }

    emitter Box
    {
        angle               35
        colour              0.6 1.0 0.9 1.0
        emission_rate       14
        time_to_live_min    1.5
        time_to_live_max    2.8
        direction           0 0 1
        velocity_min        0.4
        velocity_max        1.1
        width               1.6
        height              1.6
        depth               0.6
        duration            12
    }

    affector LinearForce
    {
        force_vector      0 0 -0.6
        force_application add
    }

    affector DirectionRandomiser
    {
        randomness      1.5
        scope           1
        keep_velocity   true
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 0.7 1 0.9 1
        time1   0.3
        colour1 0.2 1 0.7 1
        time2   1
        colour2 0 0 0 1
    }
}

// Dark smoke that rises from the ruin for a few seconds, blended over the scene (alpha fades here)
particle_system HeartExplosionSmoke
{
    material            DefeatSmoke
    point_rendering     false
    particle_width      1.3
    particle_height     1.3
    cull_each           false
    quota               60
    billboard_type      point
    sorted              true
    texture_sheet_size  3 5

    emitter Ellipsoid
    {
        angle               30
        colour              0.12 0.1 0.09 0.8
        emission_rate       14
        time_to_live_min    3.0
        time_to_live_max    5.0
        direction           0 0 1
        velocity_min        0.3
        velocity_max        0.7
        width               1.2
        height              1.2
        depth               0.6
        duration            2.5
    }

    affector ColourFader
    {
        alpha -0.2
    }

    affector Scaler
    {
        rate 0.35
    }

    affector TextureAnimator
    {
        texcoord_count  15
        duration        4
        random_offset   true
    }
}
