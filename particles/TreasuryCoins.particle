// Effects on the gold of a treasury: coins thrown up by feet and rained down by workers (see
// RenderManager::treasuryCreatureStep and RenderManager::rrTreasuryDeposit), gold dust over full piles and over the
// portal and the heart of a rich keeper (RenderManager::updateTreasuryDust), coins that slide down a heap, coins
// that roll away from the dent where gold was taken, and a soft sparkle on rich piles (see
// RenderManager::updateTreasuryAmbient and RenderManager::startTreasuryPileChange). The sprites are the ones of
// the creature reaction particles.

// Coins thrown up by feet in deep treasury gold, and coins that rain onto a pile when gold is delivered
// (over the whole tile, not only the top).

particle_system TreasuryCoinSplash
{
    material        ReactionParticleCoin
    point_rendering false
    particle_width  0.07
    particle_height 0.07
    cull_each       false
    quota           10
    billboard_type  point

    emitter Point
    {
        angle               50
        colour_range_start  1.0 0.9 0.5 1.0
        colour_range_end    1.0 0.75 0.25 1.0
        emission_rate       60
        time_to_live_min    0.4
        time_to_live_max    0.7
        direction           0 0 1
        velocity_min        0.7
        velocity_max        1.4
        duration            0.12
    }

    affector LinearForce
    {
        force_vector      0 0 -4.5
        force_application add
    }

    affector Rotator
    {
        rotation_speed_range_start  -300
        rotation_speed_range_end    300
        rotation_range_start        0
        rotation_range_end          360
    }

    affector ColourFader
    {
        alpha -1.0
    }
}

particle_system TreasuryCoinPour
{
    material        ReactionParticleCoin
    point_rendering false
    particle_width  0.07
    particle_height 0.07
    cull_each       false
    quota           24
    billboard_type  point

    emitter Box
    {
        width               0.8
        height              0.8
        depth               0.1
        angle               25
        colour_range_start  1.0 0.9 0.5 1.0
        colour_range_end    1.0 0.75 0.25 1.0
        emission_rate       60
        time_to_live_min    0.5
        time_to_live_max    0.8
        direction           0 0 -1
        velocity_min        0.3
        velocity_max        0.9
        position            0 0 0.4
        duration            0.5
    }

    affector LinearForce
    {
        force_vector      0 0 -2.5
        force_application add
    }

    affector Rotator
    {
        rotation_speed_range_start  -200
        rotation_speed_range_end    200
        rotation_range_start        0
        rotation_range_end          360
    }

    affector ColourFader
    {
        alpha -1.0
    }
}

// Soft golden motes drifting up from a completely filled treasury (one puff per attempt, see
// RenderManager::updateTreasuryDust).
particle_system TreasuryGoldDust
{
    material        ReactionParticleSpark
    point_rendering false
    particle_width  0.05
    particle_height 0.05
    cull_each       false
    quota           10
    billboard_type  point

    emitter Box
    {
        angle               20
        colour_range_start  1.0 0.85 0.4 0.7
        colour_range_end    1.0 0.7 0.2 0.5
        emission_rate       5
        time_to_live_min    1.2
        time_to_live_max    2.2
        direction           0 0 1
        velocity_min        0.04
        velocity_max        0.12
        width               0.8
        height              0.8
        depth               0.1
        duration            2.0
    }

    affector ColourFader
    {
        alpha -0.35
    }
}

// Finer, slower motes above the dungeon heart of a rich keeper (see RenderManager::startTreasuryHeartDust).
