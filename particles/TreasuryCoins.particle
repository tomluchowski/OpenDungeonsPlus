    emitter Ring
    {
        angle               75
        colour_range_start  1.0 0.9 0.5 1.0
        colour_range_end    1.0 0.75 0.25 1.0
        emission_rate       6
        time_to_live_min    0.7
        time_to_live_max    1.1
        direction           0 0 -1
        velocity_min        0.12
        velocity_max        0.3
