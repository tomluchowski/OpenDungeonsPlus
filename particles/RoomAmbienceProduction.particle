// Specks of dust in a beam of light
particle_system RoomAmbMotes
{
    material        RoomAmbDust
    point_rendering false
    particle_width  0.05
    particle_height 0.05
    cull_each       false
    quota           10
    billboard_type  point

    emitter Box
    {
        angle               180
        colour              1.0 0.95 0.7 0.0
        emission_rate       2
        time_to_live        5
        direction           0 0 1
        velocity_min        0.02
        velocity_max        0.08
        position            0 0 0.5
        width               1.0
        height              1.0
        depth               0.8
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 1.0 0.95 0.7 0.0
        time1   0.5
        colour1 1.0 0.95 0.7 0.7
        time2   1
        colour2 1.0 0.95 0.7 0.0
    }

    affector DirectionRandomiser
    {
        randomness  0.1
        scope       0.5
        keep_velocity true
    }
}

// Pages lifted by an air current
particle_system RoomAmbPages
{
    material        RoomAmbPage
    point_rendering false
    particle_width  0.14
    particle_height 0.14
    cull_each       false
    quota           4
    billboard_type  point

    emitter Box
    {
        angle               40
        colour              1.0 1.0 1.0 0.0
        emission_rate       0.7
        time_to_live        3.2
        direction           0 0 1
        velocity_min        0.25
        velocity_max        0.5
        width               0.3
        height              0.3
        depth               0.05
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 1.0 1.0 1.0 0.0
        time1   0.3
        colour1 1.0 1.0 1.0 0.9
        time2   1
        colour2 1.0 1.0 1.0 0.0
    }

    affector Rotator
    {
        rotation_speed_range_start  -90
        rotation_speed_range_end    90
        rotation_range_start        0
        rotation_range_end          360
    }

    affector DirectionRandomiser
    {
        randomness  0.3
        scope       0.5
        keep_velocity true
    }
}

