// Effects of the production rooms: workshop, library, training hall, treasury and hatchery
// (see config/roomAmbienceProduction.cfg).

// ---- Workshop ----

// Dark smoke rising from a chimney
particle_system RoomAmbForgeSmoke
{
    material        RoomAmbSmoke
    point_rendering false
    particle_width  0.35
    particle_height 0.35
    cull_each       false
    quota           14
    billboard_type  point

    emitter Point
    {
        angle               14
        colour_range_start  0.28 0.27 0.26 0.5
        colour_range_end    0.4 0.38 0.36 0.55
        emission_rate       3
        time_to_live        3.6
        direction           0 0 1
        velocity_min        0.45
        velocity_max        0.8
    }

    affector Scaler
    {
        rate    0.3
    }

    affector ColourFader
    {
        alpha   -0.14
    }

    affector DirectionRandomiser
    {
        randomness  0.25
        scope       0.4
        keep_velocity true
    }
}

// The glow of a fire: one steady billboard, the game makes it flicker
particle_system RoomAmbEmberGlow
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  0.7
    particle_height 0.7
    cull_each       false
    quota           1
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 0.5 0.15 0.7
        emission_rate       2
        time_to_live        100000
        direction           0 0 1
        velocity            0
    }
}

// Embers rising from a fire
particle_system RoomAmbEmbers
{
    material        RoomAmbSpark
    point_rendering false
    particle_width  0.07
    particle_height 0.07
    cull_each       false
    quota           10
    billboard_type  point

    emitter Box
    {
        angle               30
        colour_range_start  1.0 0.55 0.15 1.0
        colour_range_end    1.0 0.8 0.3 1.0
        emission_rate       2.5
        time_to_live        1.8
        direction           0 0 1
        velocity_min        0.4
        velocity_max        1.0
        width               0.3
        height              0.3
        depth               0.05
    }

    affector ColourFader
    {
        alpha   -0.55
    }

    affector DirectionRandomiser
    {
        randomness  0.4
        scope       0.5
        keep_velocity true
    }
}

// Sparks thrown up now and then where something is hammered
particle_system RoomAmbAnvilSparks
{
    material        RoomAmbSpark
    point_rendering false
    particle_width  0.09
    particle_height 0.09
    cull_each       false
    quota           30
    billboard_type  point

    emitter Point
    {
        angle               75
        colour_range_start  1.0 0.85 0.4 1.0
        colour_range_end    1.0 1.0 0.8 1.0
        emission_rate       90
        time_to_live        0.55
        direction           0 0 1
        velocity_min        1.2
        velocity_max        2.6
        duration            0.14
        repeat_delay_min    0.7
        repeat_delay_max    2.0
    }

    affector LinearForce
    {
        force_vector        0 0 -6
        force_application   add
    }

    affector ColourFader
    {
        alpha   -1.5
    }
}

