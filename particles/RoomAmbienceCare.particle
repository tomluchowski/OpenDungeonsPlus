// ---- Crypt ----

// Mist lying low over the floor
particle_system RoomAmbMist
{
    material        RoomAmbSmoke
    point_rendering false
    particle_width  1.1
    particle_height 1.1
    cull_each       false
    quota           5
    billboard_type  point

    emitter Box
    {
        angle               90
        colour              0.6 0.78 0.66 0.0
        emission_rate       0.8
        time_to_live        6
        direction           1 0 0
        velocity_min        0.03
        velocity_max        0.1
        position            0 0 0.12
        width               1.0
        height              1.0
        depth               0.05
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 0.6 0.78 0.66 0.0
        time1   0.5
        colour1 0.6 0.78 0.66 0.22
        time2   1
        colour2 0.6 0.78 0.66 0.0
    }

    affector Scaler
    {
        rate    0.08
    }
}

