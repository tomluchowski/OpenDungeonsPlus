[Graphics]
@OD_OGRE_SHADER_RESOURCES@
FileSystem=materials/scripts
FileSystem=materials/scripts/Creatures
FileSystem=materials/textures
FileSystem=models
FileSystem=particles
FileSystem=shaders

# Internal shadow programs must also be visible to OGRE's global resource pool.
# Keep Main in Graphics above for game shader includes with strict group lookup.
[OgreInternal]
FileSystem=@OD_OGRE_MEDIA_DIR@/RTShaderLib/../Main

[GUI]
FileSystem=gui
FileSystem=gui/fonts
FileSystem=gui/schemas

[Music]
FileSystem=music

[Sound]
FileSystem=sounds
