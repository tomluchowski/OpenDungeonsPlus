material CreatureExperience
{
    technique
    {
        pass
        {
            lighting off
            depth_check off
            depth_write off
            scene_blend alpha_blend
            texture_unit
            {
                texture CreatureExperience.png
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}

material CreatureRecovery
{
    technique
    {
        pass
        {
            lighting off
            depth_check off
            depth_write off
            scene_blend alpha_blend
            texture_unit
            {
                texture CreatureRecovery.png
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}
