// Materials of the sprites of the production rooms (see particles/RoomAmbienceProduction.particle).

material RoomAmbPage
{
    technique
    {
        pass
        {
            lighting off
            scene_blend alpha_blend
            depth_write off
            diffuse vertexcolour

            texture_unit
            {
                texture RoomAmbPage.png
            }
        }
    }
}

material RoomAmbRune
{
    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off
            diffuse vertexcolour

            texture_unit
            {
                texture RoomAmbRune.png
