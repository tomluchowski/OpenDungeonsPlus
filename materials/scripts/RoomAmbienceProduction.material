// Materials of the sprites of the production rooms. Only the rune and grain sprites that the traps also use are here for now.

material RoomAmbRune
{
    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off
            diffuse vertexcolour

            texture_unit
            {
                texture RoomAmbRune.png
            }
        }
    }
}

material RoomAmbGrain
{
    technique
    {
        pass
        {
            lighting off
            scene_blend alpha_blend
            depth_write off
            diffuse vertexcolour

            texture_unit
            {
                texture RoomAmbGrain.png
            }
        }
    }
}
