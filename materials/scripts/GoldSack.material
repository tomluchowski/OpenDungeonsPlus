// Sack of gold carried by workers (meshes built at run time by source/render/LooseGoldMesh.cpp)
material GoldSack
{
    receive_shadows on

    technique
    {
        pass
        {
            ambient 0.75 0.7 0.6 1.0
            diffuse 0.9 0.82 0.7 1.0
            specular 0.05 0.05 0.05 1.0 4.0
            emissive 0.03 0.025 0.015 1.0

            texture_unit
            {
                texture GoldSack.png
                tex_address_mode wrap
                filtering trilinear
            }
        }
    }
}
