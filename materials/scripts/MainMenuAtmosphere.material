vertex_program MenuAtmosphereVertex glsl
{
    source MenuAtmosphere.vert
}

fragment_program MenuAtmosphereFragment glsl
{
    source MenuAtmosphere.frag
    default_params
    {
        param_named tint float4 1 1 1 0
        param_named time float 0
        param_named mist float 0
    }
}

material MainMenuAtmosphereGlow
{
    technique
    {
        pass
        {
            lighting off
            depth_check off
            depth_write off
            scene_blend src_alpha one
            vertex_program_ref MenuAtmosphereVertex
            {
            }
            fragment_program_ref MenuAtmosphereFragment
            {
                param_named mist float 0
            }
        }
    }
}

material MainMenuAtmosphereFog
{
    technique
    {
        pass
        {
            lighting off
            depth_check off
            depth_write off
            scene_blend alpha_blend
            vertex_program_ref MenuAtmosphereVertex
            {
            }
            fragment_program_ref MenuAtmosphereFragment
            {
                param_named mist float 1
            }
        }
    }
}
