// Dormitory
// import RTSS/NormalMapping_MultiPass from "RTShaderSystem.material"


vertex_program myDormitoryVertexShader glsl
{
  source Room.vert
    default_params
    {
        param_named_auto projectionMatrix projection_matrix
        param_named_auto viewMatrix view_matrix
        param_named_auto worldMatrix world_matrix
        param_named_auto lightMatrix texture_worldviewproj_matrix  
    }
  
}

fragment_program myDormitoryFragmentShader glsl
{
  source Room.frag
  preprocessor_defines DORMITORY_FLOOR=1
    default_params
    {
        param_named_auto ambientLightColour ambient_light_colour
        param_named_auto lightDiffuseColour light_diffuse_colour 0.0 
        param_named_auto lightSpecularColour light_specular_colour 0.0 
        param_named_auto lightPos light_position  0.0 0.0 0.0 0.0
        param_named_auto cameraPosition camera_position   
        param_named shadowingEnabled bool false              
    }
}


material Dormitory //: RTSS/NormalMapping_MultiPass
{
    
    technique
    {

        pass 
        {
            vertex_program_ref myDormitoryVertexShader
            {
                
            }
            fragment_program_ref myDormitoryFragmentShader
            { 
                param_named decalmap int 0
                param_named normalmap int 1
                param_named shadowmap int 2
                param_named dormitoryEdge int 3
                param_named dormitoryCorner int 4
                param_named dormitoryBorders float4 1 1 1 1
            }            
            
            
            // We use blending, so that we can see the underlying texture.
            texture_unit decalmap
            {
                texture Dormitory1111.png
            }
        
            texture_unit normalmap
            {
                texture Dormitory1111Normal.png
            }  
            texture_unit shadowmap
            {
                content_type shadow
                tex_address_mode clamp
                filtering bilinear              
                
            }    
            texture_unit dormitoryEdge
            {
                texture Dormitory1011.png
                tex_address_mode clamp
            }
            texture_unit dormitoryCorner
            {
                texture Dormitory1100.png
                tex_address_mode clamp
            }
        }

    }
}

// Canonical end opens south; the passage opens north and south.
material DormitoryEnd : Dormitory
{
    technique
    {
        pass
        {
            fragment_program_ref myDormitoryFragmentShader
            {
                param_named dormitoryBorders float4 1 0 1 1
            }
        }
    }
}

material DormitoryPassage : Dormitory
{
    technique
    {
        pass
        {
            fragment_program_ref myDormitoryFragmentShader
            {
                param_named dormitoryBorders float4 1 0 1 0
            }
        }
    }
}
