// DungeonTemple

// The Stacheln spikes used a spherical environment map via the legacy
// fixed-function "env_map spherical" and "colour_op_ex blend_manual"
// directives, which were removed in Ogre 14.x. The reflection and the
// blending are now done in DungeonTemple.vert/.frag (same env-map formula
// as ReflMetal.frag); the surface colours still come from the pass below.
vertex_program myDungeonTempleVertexShader glsl
{
    source DungeonTemple.vert
    default_params
    {
        param_named_auto projectionMatrix projection_matrix
        param_named_auto viewMatrix view_matrix
        param_named_auto worldMatrix world_matrix
    }
}

fragment_program myDungeonTempleFragmentShader glsl
{
    source DungeonTemple.frag
    default_params
    {
        param_named_auto ambientLightColour ambient_light_colour
        param_named_auto lightDiffuseColour light_diffuse_colour 0
        param_named_auto lightPos light_position 0
        param_named_auto cameraPosition camera_position
        param_named_auto surfaceAmbient surface_ambient_colour
        param_named_auto surfaceDiffuse surface_diffuse_colour
        param_named_auto surfaceEmissive surface_emissive_colour
    }
}

material Sphere2
{
    receive_shadows off
    technique
    {
        pass
        {
            ambient 0.0 0.0 0.0 1.0
            diffuse 0.0 0.4 0.8 1.0
            specular 0.5 0.5 0.5 1.0 12.5
            emissive 0.0 0.4 0.9 1.0
        }
    }
}

material Sphere
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.0 0.0 0.0 1.0
            diffuse 0.7 0.25 0.0 1.0
            specular 0.0 0.0 0.0 1.0 12.5
            emissive 0.95 0.35 0.0 1.0

        }
    }
}

material Stacheln
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.0 0.0 0.0 1.0
            diffuse 0.4 0.4 0.4 1.0
            specular 0.0 0.0 0.0 1.0 12.5
            emissive 0.0 0.0 0.0 1.0

            vertex_program_ref myDungeonTempleVertexShader
            {
            }

            fragment_program_ref myDungeonTempleFragmentShader
            {
                param_named decalMap int 0
                param_named envMap int 1
            }

            texture_unit
            {
                texture DungeonTemple.png
                tex_address_mode wrap
                filtering trilinear
            }
            texture_unit
            {
                texture EnvmapMetal.png
            }
        }
    }
}
