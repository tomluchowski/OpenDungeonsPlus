material DoorRuneGlow
{
    receive_shadows off

    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off

            texture_unit
            {
                texture DoorRuneGlow.png
                tex_address_mode clamp
            }
        }
    }
}
