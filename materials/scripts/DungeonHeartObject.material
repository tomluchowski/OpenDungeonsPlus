// DungeonHeartObject: the three health-tier variants of the animated heart
// (assets-src/DungeonHeartObject.blend, rebuilt by tools/heart-on-temple). Kept in its own script so the
// existing DungeonTemple.material (used by the room platform mesh) is left untouched.
//
// The heart is lit per pixel by the room's lights with a tangent space normal map and a colour texture, both
// generated by tools/heart-textures and mapped by the texture coordinates that tools/heart-on-temple writes into the
// mesh. The palette is the crimson of the HUD's heart icon; the damaged and critical tiers keep it and add bruises,
// cracks, scars and a little blood. A second texture layer adds faint embers in the cracks on top of the lit surface;
// the emissive term stays tiny, so that the heart looks lit by the room and not self-coloured.

material DungeonHeartHealthy
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.55 0.55 0.55 1.0
            diffuse 1.0 1.0 1.0 1.0
            specular 0.22 0.14 0.12 1.0 9.0
            emissive 0.03 0.0 0.0 1.0

            texture_unit
            {
                texture DungeonHeartHealthy.png
                tex_address_mode wrap
                filtering trilinear
            }

            texture_unit
            {
                texture DungeonHeartHealthyGlow.png
                tex_address_mode wrap
                filtering trilinear
                colour_op add
            }

            rtshader_system
            {
                lighting_stage normal_map DungeonHeartHealthyNormal.png tangent_space
            }
        }
    }
}

material DungeonHeartDamaged
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.55 0.55 0.55 1.0
            diffuse 1.0 1.0 1.0 1.0
            specular 0.16 0.11 0.10 1.0 8.0
            emissive 0.02 0.0 0.0 1.0

            texture_unit
            {
                texture DungeonHeartDamaged.png
                tex_address_mode wrap
                filtering trilinear
            }

            texture_unit
            {
                texture DungeonHeartDamagedGlow.png
                tex_address_mode wrap
                filtering trilinear
                colour_op add
            }

            rtshader_system
            {
                lighting_stage normal_map DungeonHeartDamagedNormal.png tangent_space
            }
        }
    }
}

material DungeonHeartCritical
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.80 0.80 0.80 1.0
            diffuse 1.0 1.0 1.0 1.0
            specular 0.30 0.20 0.18 1.0 14.0
            emissive 0.02 0.0 0.0 1.0

            texture_unit
            {
                texture DungeonHeartCritical.png
                tex_address_mode wrap
                filtering trilinear
            }

            texture_unit
            {
                texture DungeonHeartCriticalGlow.png
                tex_address_mode wrap
                filtering trilinear
                colour_op add
            }

            rtshader_system
            {
                lighting_stage normal_map DungeonHeartCriticalNormal.png tangent_space
            }
        }
    }
}

// The pedestal under the heart (submesh "Pedestal"). It used the temple material "Stacheln", whose texture has
// baked-in white highlight blobs and whose spherical environment map layer sparkled on top of the lit surface.
// This material uses a cleaned dark stone texture (tools/heart-textures/generate_pedestal_texture.py), no
// environment map and only a faint specular term. The name has as many characters as "Stacheln", so the meshes
// could be re-pointed at it byte for byte.
material Obsidian
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.5 0.5 0.5 1.0
            diffuse 0.7 0.7 0.7 1.0
            specular 0.05 0.05 0.06 1.0 6.0
            emissive 0.0 0.0 0.0 1.0

            texture_unit
            {
                texture DungeonHeartPedestal.png
                tex_address_mode wrap
                filtering trilinear
            }
        }
    }
}
