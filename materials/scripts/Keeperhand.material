// Keeperhand
import RTSS/NormalMapping_MultiPass from "RTShaderSystem.material"
material Keeperhand
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.0 0.0 0.0 1.0
            diffuse 0.0 0.0 0.0 1.0
            specular 0.0 0.0 0.0 0.0 2.0
            emissive 0.0 0.0 0.0 0.0
            scene_blend one zero
            depth_check on
            depth_write on
            cull_hardware none
            cull_software none
            texture_unit
            {
                texture Keeperhand.png
                tex_address_mode wrap
                filtering trilinear
                colour_op alpha_blend
            }
        }
    }
}

// Opaque fingers must hide the enclosed shaft while gripping the tool.
material Keeperhand/ToolGrip : Keeperhand
{
    technique
    {
        pass
        {
            ambient 0.0 0.0 0.0 1.0
            diffuse 0.0 0.0 0.0 1.0
            scene_blend one zero
            depth_check on
            depth_write on
        }
    }
}
