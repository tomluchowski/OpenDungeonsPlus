// Pickaxe carried by the dwarf worker
import RTSS/PerPixel_SinglePass from "RTShaderSystem.material"
material DwarfPick : RTSS/PerPixel_SinglePass
{
    technique
    {
        pass
        {
            ambient 1.0 1.0 1.0 1.0
            diffuse 1.0 1.0 1.0 1.0
            specular 0.3 0.3 0.3 1.0 16.0
            emissive 0.0 0.0 0.0 0.0

            texture_unit
            {
                texture DwarfPickSurface.png
            }
        }
    }
}
