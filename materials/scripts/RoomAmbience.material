// Materials of the room ambience sprites (see particles/RoomAmbience.particle). Sprites are drawn by tools/gen_room_ambience_art.py.

material RoomAmbSpark
{
    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off
            diffuse vertexcolour

            texture_unit
            {
                texture RoomAmbSpark.png
            }
        }
    }
}

