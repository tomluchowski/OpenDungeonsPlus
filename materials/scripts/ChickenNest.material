// Materials of the hatchery nests: loose straw nest (small own texture) and the matt straw inside the coop.

material ChickenNest
{
    receive_shadows on
    technique
    {
        pass
        {
            cull_hardware none
            cull_software none
            ambient 0.62 0.55 0.42 1.0
            diffuse 0.7 0.62 0.46 1.0
            specular 0.0 0.0 0.0 1.0 1
            texture_unit
            {
                texture ChickenNest.png
                tex_address_mode wrap
            }
        }
    }
}

material ChickenCoopStraw
{
    receive_shadows on
    technique
    {
        pass
        {
            cull_hardware none
            cull_software none
            ambient 0.44 0.35 0.2 1.0
            diffuse 0.5 0.4 0.23 1.0
            specular 0.0 0.0 0.0 1.0 1
        }
    }
}
