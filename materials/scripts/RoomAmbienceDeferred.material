// Materials of the extra room effects (see particles/RoomAmbienceDeferred.particle). Sprites are drawn by tools/gen_room_effects_art.py.

material RoomAmbFlame
{
    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off
            diffuse vertexcolour

            texture_unit
            {
                texture RoomAmbFlame.png
            }
        }
    }
}

material RoomAmbBracket
{
    technique
    {
        pass
        {
            lighting off
            scene_blend alpha_blend
            depth_write off
            diffuse vertexcolour

            texture_unit
            {
                texture RoomAmbBracket.png
            }
        }
    }
}

