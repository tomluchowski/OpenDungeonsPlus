material RoomAmbSoftRing
{
    technique
    {
        pass
        {
            lighting off
            // Added to the picture, weighted by the alpha (see RoomAmbRing)
            scene_blend src_alpha one
            depth_write off
            diffuse vertexcolour

            texture_unit
            {
                texture RoomAmbSoftRing.png
            }
        }
    }
}
