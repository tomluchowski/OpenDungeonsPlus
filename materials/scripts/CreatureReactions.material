// Emote icons shown above a creature and sprites of the creature reaction particles.
// The images are drawn by tools/gen_creature_reaction_art.py

material CreatureEmote_Exclamation
{
    technique
    {
        pass
        {
            scene_blend alpha_blend
            texture_unit
            {
                texture CreatureEmoteExclamation.png
            }
        }
    }
}

