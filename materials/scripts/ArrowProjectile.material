// Use the bow atlas directly, without the generic panel-material pass.
material ArrowProjectile
{
    receive_shadows on

    technique
    {
        pass
        {
            ambient 0.9 0.9 0.9
            diffuse 0.9 0.9 0.9
            specular 0.2 0.2 0.2 16
            emissive 0.12 0.1 0.07

            texture_unit decalmap
            {
                texture Bow.png
                tex_address_mode wrap
            }
        }
    }
}
